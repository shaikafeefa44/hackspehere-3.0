# Flask — use a long random value in AppSail (python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace-with-a-long-random-string
FLASK_DEBUG=0
PORT=9000
REQUIRE_STRONG_SECRET=0

# local | catalyst_datastore | stratus  (AppSail disk is ephemeral)
STORAGE_BACKEND=local
CATALYST_DATASTORE_TABLE=MicrogridBlobs
STRATUS_BUCKET=hacksphere-microgrid

# Optional: published Zoho Catalyst QuickML endpoint
# Leave blank to use the bundled local OLS fallback model.
QUICKML_ENDPOINT=
QUICKML_AUTH_TOKEN=
QUICKML_FEATURE_MODE=engineered

# Optional AI Assistant LLM endpoint (fallback to rules if blank)
LLM_ENDPOINT=
LLM_AUTH_TOKEN=

# Overload alerts (optional — the dashboard still records alerts if these are empty)
ALERT_EMAIL_TO=ops@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=hacksphere-alerts@example.com

# Optional Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
ALERT_SMS_TO=
